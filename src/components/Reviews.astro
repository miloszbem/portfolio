---
import type { LangCopy } from '../i18n/copy'

interface Props {
	pl: LangCopy
	en: LangCopy
}
const { pl, en } = Astro.props
---

<section class="reviews">
<div class="reviews-inner">
	<div data-reveal class="reviews-header">
		<div class="eyebrow" data-pl={pl.revEy} data-en={en.revEy}>{pl.revEy}</div>
		<h2 class="section-title" data-pl={pl.revTitle} data-en={en.revTitle}>{pl.revTitle}</h2>
	</div>
	<div class="reviews-track" data-reviews-track>
		<div data-reveal class="review-card">
			<div class="quote-mark">"</div>
			<p class="quote-text" data-pl={pl.rev1} data-en={en.rev1}>{pl.rev1}</p>
			<div class="reviewer">
				<img src="/damian-dzida-logo.png" alt="Damian Dzida" class="avatar" loading="lazy" />
				<div>
					<div class="reviewer-name">Damian Dzida</div>
					<div class="reviewer-role">Kancelaria Adwokacka Damian Dzida · Jasło</div>
				</div>
			</div>
		</div>
		<div data-reveal data-reveal-d="1" class="review-card">
			<div class="quote-mark">"</div>
			<p class="quote-text" data-pl={pl.rev2} data-en={en.rev2}>{pl.rev2}</p>
			<div class="reviewer">
				<img src="/pod24-logo.png" alt="POD24.info" class="avatar" loading="lazy" />
				<div>
					<div class="reviewer-name">POD24.info</div>
					<div class="reviewer-role" data-pl="Serwis informacyjny regionu Jarosławia i Podkarpacia" data-en="News portal for the Jarosław and Podkarpacie region">Serwis informacyjny regionu Jarosławia i Podkarpacia</div>
				</div>
			</div>
		</div>
	</div>
</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-reviews-track]').forEach((track) => {
		const isMobile = window.matchMedia('(max-width: 768px)').matches
		if (!isMobile) return

		const originalCards = Array.from(track.children)
		originalCards.forEach((card) => {
			const clone = card.cloneNode(true) as HTMLElement
			clone.setAttribute('aria-hidden', 'true')
			clone.removeAttribute('data-reveal')
			clone.removeAttribute('data-reveal-d')
			clone.style.opacity = '1'
			clone.style.transform = 'none'
			track.appendChild(clone)
		})
		const loopWidth = () => {
			const gap = parseFloat(getComputedStyle(track).gap || '0')
			return originalCards.reduce((sum, card) => sum + (card as HTMLElement).offsetWidth + gap, 0)
		}

		let isDown = false
		let startX = 0
		let scrollStart = 0
		let dragged = false
		const speed = 22 // px/s, nie px/klatkę - inaczej 120Hz jedzie 2x szybciej niż 60Hz
		const resumeDelay = 3000
		let pausedUntil = 0
		let visible = true
		let last = 0
		// Własny licznik float: scrollLeft kwantyzuje się do pikseli urządzenia,
		// więc czyste += na nim gubi ułamkowe przyrosty przy niskiej prędkości / 120Hz.
		let pos = track.scrollLeft
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

		const canRun = () => visible && !reducedMotion && !isDown

		const step = (now: number) => {
			requestAnimationFrame(step)
			const elapsed = last ? now - last : 0
			last = now
			if (!canRun() || Date.now() < pausedUntil) {
				pos = track.scrollLeft
				return
			}
			const width = loopWidth()
			if (width <= 0) return
			pos = pos >= width ? 0 : pos + (speed * elapsed) / 1000
			track.scrollLeft = pos
		}

		const hold = () => {
			pausedUntil = Date.now() + resumeDelay
		}

		new IntersectionObserver((entries) => {
			visible = entries[0].isIntersecting
		}).observe(track)

		track.addEventListener('mousedown', (e) => {
			isDown = true
			dragged = false
			startX = e.clientX
			scrollStart = track.scrollLeft
			track.classList.add('is-dragging')
			hold()
		})
		window.addEventListener('mousemove', (e) => {
			if (!isDown) return
			const dx = e.clientX - startX
			if (Math.abs(dx) > 4) dragged = true
			const width = loopWidth()
			let next = scrollStart - dx
			if (width > 0) {
				next = ((next % width) + width) % width
			}
			track.scrollLeft = next
		})
		const endDrag = () => {
			if (!isDown) return
			isDown = false
			track.classList.remove('is-dragging')
			hold()
		}
		window.addEventListener('mouseup', endDrag)

		track.addEventListener('touchstart', hold, { passive: true })
		track.addEventListener('touchend', hold, { passive: true })
		track.addEventListener('wheel', hold, { passive: true })

		track.addEventListener(
			'click',
			(e) => {
				if (dragged) {
					e.preventDefault()
					e.stopPropagation()
				}
			},
			{ capture: true }
		)

		requestAnimationFrame(step)
	})
</script>

<style>
	.reviews {
		padding: 84px 56px;
	}

	.reviews-inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	.reviews-header { margin-bottom: 44px; }

	.eyebrow {
		font-size: 11px;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 10px;
		font-weight: 600;
	}

	.section-title {
		font-family: var(--display);
		font-size: 40px;
		font-weight: 600;
		letter-spacing: -0.5px;
		line-height: 1.05;
	}

	.reviews-track {
		display: flex;
		gap: 14px;
		overflow-x: auto;
		cursor: grab;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.reviews-track::-webkit-scrollbar {
		display: none;
	}

	.reviews-track.is-dragging {
		cursor: grabbing;
	}

	@media (min-width: 769px) {
		.reviews-track {
			justify-content: center;
			cursor: default;
		}
	}

	.review-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 30px;
		flex: 0 0 min(420px, 88vw);
		scroll-snap-align: start;
		user-select: none;
	}

	.quote-mark {
		font-family: var(--display);
		font-size: 30px;
		color: var(--accent);
		line-height: 1;
		margin-bottom: 14px;
	}

	.quote-text {
		font-size: 15px;
		line-height: 1.7;
		color: var(--muted);
		margin: 0 0 22px;
	}

	.reviewer {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.avatar {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}

	.reviewer-name {
		font-size: 14px;
		font-weight: 600;
		color: var(--text);
	}

	.reviewer-role {
		font-size: 11px;
		color: rgba(15, 22, 41, 0.35);
		margin-top: 2px;
	}

	@media (max-width: 768px) {
		.reviews { padding: 64px 16px; }
	}
</style>
