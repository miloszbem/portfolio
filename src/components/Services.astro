---
import type { LangCopy } from '../i18n/copy'

interface Props {
	pl: LangCopy
	en: LangCopy
}
const { pl, en } = Astro.props

const packages = ['pkg1', 'pkg2', 'pkg3'] as const
---

<section id="uslugi" class="services">
	<div class="services-inner">
		<div data-reveal class="services-header">
			<div class="eyebrow" data-pl={pl.servEy} data-en={en.servEy}>{pl.servEy}</div>
			<h2 class="section-title" data-pl={pl.servTitle} data-en={en.servTitle}>{pl.servTitle}</h2>
		</div>
		<div data-reveal class="services-tabs" role="tablist">
			{packages.map((key, i) => {
				const plPkg = pl[key]
				const enPkg = en[key]
				return (
					<button
						type="button"
						class={`services-tab${i === 0 ? ' is-active' : ''}`}
						data-services-tab={key}
						role="tab"
						aria-selected={i === 0 ? 'true' : 'false'}
						data-pl={plPkg.name}
						data-en={enPkg.name}
					>
						{plPkg.name}
					</button>
				)
			})}
		</div>
		<div class="services-grid">
			{packages.map((key, i) => {
				const plPkg = pl[key]
				const enPkg = en[key]
				return (
					<div data-services-panel={key} class={`service-card border-accent${i === 0 ? ' is-active' : ''}`}>
						{plPkg.includesNote && (
							<div class="sv-note" data-pl={plPkg.includesNote} data-en={enPkg.includesNote}>{plPkg.includesNote}</div>
						)}
						<div class="sv-title" data-pl={plPkg.name} data-en={enPkg.name}>{plPkg.name}</div>
						<div class="sv-desc" data-pl={plPkg.teaser} data-en={enPkg.teaser}>{plPkg.teaser}</div>
						{key === 'pkg2' && (
							<a href="/miesieczna-analiza/" class="sv-analytics-link" data-pl={pl.analyticsCta} data-en={en.analyticsCta}>{pl.analyticsCta}</a>
						)}
						<div class="sv-price-block">
							{plPkg.price ? (
								<div class="sv-price">
									<span data-pl={pl.priceFrom} data-en={en.priceFrom}>{pl.priceFrom}</span>{' '}
									<span data-pl={plPkg.price} data-en={enPkg.price}>{plPkg.price}</span>{' '}
									<span data-pl={pl.net} data-en={en.net}>{pl.net}</span>
								</div>
							) : (
								<div class="sv-price">
									<span data-pl={pl.quote} data-en={en.quote}>{pl.quote}</span>{' '}
									<span data-pl={pl.indiv} data-en={en.indiv}>{pl.indiv}</span>
								</div>
							)}
							{plPkg.price ? (
								plPkg.carePrice && (
									<div class="sv-care">
										<span data-pl={pl.careAddonLabel} data-en={en.careAddonLabel}>{pl.careAddonLabel}</span>{' '}
										<span data-pl={plPkg.carePrice} data-en={enPkg.carePrice}>{plPkg.carePrice}</span>
									</div>
								)
							) : (
								<div class="sv-care" data-pl={pl.careAddonQuote} data-en={en.careAddonQuote}>{pl.careAddonQuote}</div>
							)}
						</div>
						<a href="#cennik" class="sv-cta" data-pl={`${pl.detailsCta}: ${plPkg.name}`} data-en={`${en.detailsCta}: ${enPkg.name}`}>{`${pl.detailsCta}: ${plPkg.name}`}</a>
					</div>
				)
			})}
		</div>
	</div>
</section>

<style>
	.services {
		background: var(--surface);
		padding: 84px 56px;
	}

	.services-inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	.services-header { margin-bottom: 44px; }

	.eyebrow {
		font-size: 11px;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 10px;
		font-weight: 600;
	}

	.section-title {
		font-family: var(--display);
		font-size: 40px;
		font-weight: 600;
		letter-spacing: -0.5px;
		line-height: 1.05;
	}

	.services-tabs {
		display: flex;
		gap: 8px;
		margin-bottom: 20px;
	}

	.services-tab {
		flex: 1;
		min-width: 0;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 10px 12px;
		font-size: 13px;
		font-weight: 600;
		color: var(--muted);
		cursor: pointer;
		font-family: 'DM Sans', sans-serif;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		text-align: center;
	}

	.services-tab.is-active {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	.services-grid {
		display: grid;
	}

	.service-card {
		display: none;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 30px;
		border-top-width: 3px;
		flex-direction: column;
	}

	.service-card.is-active {
		display: flex;
	}

	.border-accent { border-top-color: var(--accent); }

	.sv-note {
		color: var(--accent);
		font-size: 11px;
		font-weight: 600;
		margin-bottom: 8px;
	}

	.sv-title {
		font-family: var(--display);
		font-size: 20px;
		font-weight: 600;
		margin-bottom: 9px;
	}

	.sv-desc {
		color: var(--muted);
		font-size: 14px;
		line-height: 1.65;
		margin-bottom: 20px;
	}

	.sv-analytics-link {
		display: inline-block;
		font-size: 13px;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
		margin-bottom: 20px;
	}

	.sv-analytics-link:hover {
		text-decoration: underline;
	}

	.sv-price-block {
		margin-top: auto;
		margin-bottom: 16px;
	}

	.sv-price {
		font-size: 13px;
		font-weight: 600;
		color: var(--accent);
	}

	.sv-care {
		font-size: 12px;
		color: rgba(15, 22, 41, 0.4);
		margin-top: 3px;
	}

	.sv-cta {
		font-size: 13px;
		font-weight: 600;
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 3px;
		align-self: flex-start;
	}

	@media (max-width: 768px) {
		.services { padding: 64px 16px; }
		.services-tab { padding: 9px 8px; font-size: 11.5px; }
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.services-tabs').forEach((tabs) => {
		const grid = tabs.nextElementSibling
		if (!grid) return
		tabs.querySelectorAll<HTMLButtonElement>('.services-tab').forEach((tab) => {
			tab.addEventListener('click', () => {
				const key = tab.dataset.servicesTab
				tabs.querySelectorAll('.services-tab').forEach((t) => {
					t.classList.toggle('is-active', t === tab)
					t.setAttribute('aria-selected', t === tab ? 'true' : 'false')
				})
				grid.querySelectorAll('[data-services-panel]').forEach((panel) => {
					panel.classList.toggle('is-active', panel.getAttribute('data-services-panel') === key)
				})
			})
		})
	})
</script>
